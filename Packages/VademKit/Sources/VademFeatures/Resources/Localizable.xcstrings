    "**No account.** There is no sign-up and no login." : {
      "comment" : "Privacy policy (mirrors docs/privacy.md)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**No account.** There is no sign-up and no login."
