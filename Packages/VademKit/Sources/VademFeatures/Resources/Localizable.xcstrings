    "Notifications, widget and Siri" : {
      "comment" : "Privacy policy (mirrors docs/privacy.md)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications, widget and Siri"
          }
        },
