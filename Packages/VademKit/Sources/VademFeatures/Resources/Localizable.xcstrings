    },
    "**No analytics, no tracking, no ads.** The app contains no analytics, crash reporting, advertising or tracking code and does not use any third-party services." : {
      "comment" : "Privacy policy (mirrors docs/privacy.md)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**No analytics, no tracking, no ads.** The app contains no analytics, crash reporting, advertising or tracking code and does not use any third-party services."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Analiz, takip ve reklam yok.** Uygulamada analiz, çökme raporlama, reklam veya takip kodu yoktur ve üçüncü taraf hizmet kullanılmaz."
          }
        }
      }
    },
    "**No bank connection.** The app never connects to your bank or card issuer; every value is entered by you." : {
      "comment" : "Privacy policy (mirrors docs/privacy.md)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**No bank connection.** The app never connects to your bank or card issuer; every value is entered by you."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Banka bağlantısı yok.** Uygulama bankanıza veya kart veren kuruluşa hiçbir zaman bağlanmaz; tüm değerleri siz girersiniz."
          }
        }
      }
    },
    "**No network requests.** The app does not send your data to any server, including ours." : {
      "comment" : "Privacy policy (mirrors docs/privacy.md)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**No network requests.** The app does not send your data to any server, including ours."
