// Shared build settings, applied at project level to every target.
// Target-level settings in the .pbxproj must stay empty so these values win.

IPHONEOS_DEPLOYMENT_TARGET = 18.0

// App, widget and test targets share one version. Bump the build number here only
// (the widget must match the app); no target may override these in the .pbxproj.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// Swift 6 language mode, strict concurrency.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
// Default actor isolation is OFF: @MainActor is written explicitly.
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

// Local, git-ignored overrides (DEVELOPMENT_TEAM etc.).
#include? "Local.xcconfig"
